MONGODB_URI=mongodb://127.0.0.1:27017/express_glass
# Production (Vercel): use MongoDB Atlas — NOT localhost. Example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/express_glass?retryWrites=true&w=majority
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://expressglassriverside.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Where contact/estimate notifications are delivered. If this matches SMTP_USER,
# the app auto-uses mariopanzarino+leads@yahoo.com (Yahoo blocks SMTP to self).
CONTACT_RECIPIENT_EMAIL=mariopanzarino@yahoo.com
# Optional override inbox (e.g. Gmail) when SMTP_USER is the same Yahoo account.
# LEAD_NOTIFICATION_EMAIL=
# Optional plus-tag when recipient matches SMTP_USER (default: leads).
# SMTP_SELF_DELIVERY_TAG=leads
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mariopanzarino@yahoo.com
SMTP_PASS=
SMTP_FROM="Express Glass <mariopanzarino@yahoo.com>"
NEXT_PUBLIC_SITE_URL=https://expressglassriverside.com
MAX_UPLOAD_SIZE_MB=10
UPLOADS_DIRECTORY=public/uploads
