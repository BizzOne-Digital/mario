MONGODB_URI=mongodb://127.0.0.1:27017/express_glass
# Production (Vercel): use MongoDB Atlas — NOT localhost. Example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/express_glass?retryWrites=true&w=majority
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://expressglassriverside.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
